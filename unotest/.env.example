# Copy to unotest/.env (postinstall does it for you).
# Where the scenarios point. Override for a local playground.
APP_BASE_URL=https://playground.unotest.com

# Catalog scenarios: a fixed seed freezes the live counters and the
# shortened delay keeps runs fast — both are about determinism.
CATALOG_SEED=42
CATALOG_LATENCY_MS=100

# Sandbox fixture API, the backend apiCall()/upload() talk to.
APP_API_BASE_URL=https://fixtures.unotest.com

# One screenshot per step — the viewer shows them on the step rows.
UNOTEST_STEP_SCREENSHOTS=1

# assertJudge backend: the deterministic fake provider, in-process.
# No live LLM, no keys — same setup the release gate runs on.
UNOTEST_JUDGE_MODE=local
UNOTEST_JUDGE_PROVIDER=fake

# Your team's box, if you have one — the machine that keeps the
# environments, the schedules and the run history. `bundle push` sends
# the suite there, and `npx @unotest/web box …` reads the results back.
# The address is not a credential; the personal read token that goes
# with it lives in .secrets, which does not travel.
UNOTEST_BOX_URL=https://tests.example.com

# The playground's own demo login. Public by construction: it is
# hardcoded in the playground page itself, so anyone who opens the site
# already has it. It lives here rather than in `.secrets` because
# masking works by VALUE — `playground` and `admin` occur inside ordinary
# words and URLs, and masking them shredded step labels, captured DOM and
# the playground's own address in run journals. Nothing is protected by
# masking a value the page prints; MASKING_PROBE exercises that path.
LOGIN=admin
PASSWORD=playground

# The viewer's own UI suite (unotest/e2e/viewer/*) drives a viewer over
# a frozen fixture project rather than the playground, so it needs an
# address of its own. Fixed port: a URL that moves cannot be written
# down. Those scenarios are ours to run; in a copied suite the key is
# harmless and the port is free to change.
VIEWER_URL=http://localhost:57351

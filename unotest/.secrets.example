# Copy to unotest/.secrets (postinstall does it for you).
# Used by e2e/misc/secret-masking.js and by nothing else: it pushes this
# value into a log line and a note, so you can check that runs record
# the marker and never the value. Not a credential — it protects
# nothing, which is why it can sit here in the open.
#
# Keep it long and unlike a real word if you change it. Masking replaces
# every occurrence of a VALUE, so a short one is found inside ordinary
# text and eats the middle of step labels, captured HTML and URLs.
MASKING_PROBE=probe-0123456789abcdef0123

# Your personal read token for a box, if your team runs one. Mint it
# for yourself on the box's sign-in page ("Read tokens") — it is shown
# once, it is read-only whatever your role, and it can be revoked.
# `npx @unotest/web box run <id> --env <project>/<environment>` reads a
# run with it, and so do your agent's box_* tools.
#
# It belongs here rather than in .env because .env travels inside a
# pushed bundle and this file does not: nothing sends it to a box.
UNOTEST_BOX_READ_TOKEN=

# Only our own box scenarios need this one, and only we have it.
BOX_RO_PASSWORD=

# The local box-lab stand (docs/testing/box-lab.md); a fixture, not a real secret.
BOX_LAB_PASSWORD=
